config BR2_PACKAGE_RV1106_SMARTIR_RTSP
	bool "rv1106-smartir-rtsp"
	depends on BR2_PACKAGE_RV1106_IPC_SDK
	help
	  Build SmartIR RTSP streaming application for RV1106.
	  This package provides RTSP streaming capabilities with SmartIR
	  on the RV1106 platform.

if BR2_PACKAGE_RV1106_SMARTIR_RTSP

config BR2_PACKAGE_RV1106_SMARTIR_RTSP_WIDTH
	int "Video width"
	default 1920
	help
	  Width of the video capture in pixels.

config BR2_PACKAGE_RV1106_SMARTIR_RTSP_HEIGHT
	int "Video height"
	default 1080
	help
	  Height of the video capture in pixels.

endif
