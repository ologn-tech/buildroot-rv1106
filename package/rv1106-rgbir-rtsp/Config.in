config BR2_PACKAGE_RV1106_RGBIR_RTSP
	bool "rv1106-rgbir-rtsp"
	depends on BR2_PACKAGE_LIBMPIX
	depends on BR2_PACKAGE_OPENCV4
	depends on BR2_PACKAGE_OPENCV4_LIB_HIGHGUI
	depends on BR2_PACKAGE_OPENCV4_WITH_RK
	depends on BR2_PACKAGE_RV1106_IPC_SDK
	help
	  Build RGB-IR RTSP streaming application for RV1106.
	  This package provides RTSP streaming capabilities for RGB-IR cameras
	  on the RV1106 platform.

if BR2_PACKAGE_RV1106_RGBIR_RTSP

config BR2_PACKAGE_RV1106_RGBIR_RTSP_WIDTH
	int "Video width"
	default 1600
	help
	  Width of the RGB-IR video capture in pixels.

config BR2_PACKAGE_RV1106_RGBIR_RTSP_HEIGHT
	int "Video height"
	default 1296
	help
	  Height of the RGB-IR video capture in pixels.

endif
